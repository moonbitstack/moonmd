name = "moonbitstack/moonmd"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonmd"

license = "Apache-2.0"

keywords = [
  "markdown",
  "commonmark",
  "commonmark-0.31.2",
  "gfm",
  "github-flavored-markdown",
  "md",
  "cmark",
  "parser",
  "syntax-tree",
  "ast",
  "html",
  "renderer",
  "html-renderer",
  "markdown-writer",
  "streaming",
  "incremental",
  "table",
  "strikethrough",
  "autolink",
  "task-list",
  "readme",
  "documentation",
  "moonbit",
]

description = "Markdown for MoonBit: CommonMark and GFM to a syntax tree, HTML or Markdown, whole or as it streams in."

source = "src"
